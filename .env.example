# Copy to .env. Do not commit .env. Leave DEPLOYER_PRIVATE_KEY empty until you
# place a testnet-only key in this local file yourself. Never paste it into chat.

PORT=8792
PROOFPAY_DB=./data/proofpay.sqlite
PROOFPAY_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,https://proofpay-pi.vercel.app
COOKIE_SECURE=0

# Privy dashboard → App settings. VITE_PRIVY_APP_ID is public and is bundled.
# PRIVY_APP_SECRET stays on the server. Never paste it into chat.
VITE_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPLORER_URL=https://testnet.monadvision.com
ESCROW_ADDRESS=
TOKEN_ADDRESS=

# Testnet deployer only. Leave blank to skip deployment.
DEPLOYER_PRIVATE_KEY=
