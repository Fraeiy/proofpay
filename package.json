{
  "name": "proofpay",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "node server/index.mjs",
    "test:api": "node --test server/api.test.mjs",
    "test:contracts": "hardhat test",
    "test:flow": "node scripts/local-flow.mjs",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network monadTestnet"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@openzeppelin/contracts": "5.6.1",
    "lucide-react": "^0.544.0",
    "pdf-lib": "1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "viem": "2.55.18"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "hardhat": "2.29.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
