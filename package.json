{
  "name": "proofpay",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "node server/index.mjs",
    "test:api": "node --test server/api.test.mjs",
    "test:contracts": "hardhat test",
    "test:flow": "node scripts/local-flow.mjs",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network monadTestnet"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@openzeppelin/contracts": "5.6.1",
    "@privy-io/node": "0.35.0",
    "@privy-io/react-auth": "3.47.0",
    "@stripe/stripe-js": "^1.54.2",
    "lucide-react": "^0.544.0",
    "pdf-lib": "1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "viem": "2.55.18"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@tailwindcss/vite": "^4.1.13",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
